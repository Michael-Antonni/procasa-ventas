# Copia este archivo como .env.local y completa los valores.
# Los encuentras en Supabase > Project Settings > API (o "API Keys").

# URL del proyecto, p. ej. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública ("anon" o "publishable"). Puede ir en el navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta ("service_role" o "secret"). SOLO servidor: nunca la expongas.
# La usan la gestión de usuarios y los enlaces públicos para compartir.
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: nombre que se muestra en la aplicación.
NEXT_PUBLIC_APP_NAME=Biblioteca Comercial
